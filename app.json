{
  "expo": {
    "name": "Notify",
    "slug": "notify-mobile",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "notify",
    "icon": "./assets/icon-only.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notify.app"
    },
    "android": {
      "package": "com.notify.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#20130D"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#F2B23D",
          "defaultChannel": "notify-reminders",
          "enableRemoteNotifications": false
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Notify to use your microphone while you dictate a note.",
          "speechRecognitionPermission": "Allow Notify to turn your speech into note text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#20130D",
          "image": "./assets/splash-mark.png",
          "imageWidth": 64,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
